# ------------------------------------------------------------------------------
# Snipe environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ------------------------------------------------------------------------------

# App
# Canonical, absolute base URL of the deployment. Used to build magic-link and
# Stripe redirect URLs. Must be https in production.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js — 32+ byte random secret used to sign session cookies and hash tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Postgres (Neon) — pooled connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Resend (email). Server-only.
RESEND_API_KEY=""
EMAIL_FROM="Snipe <alerts@snipe.example>"

# Upstash Redis (rate limiting). Server-only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe. SECRET key is server-only; only the publishable key may be public.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs -> plan tiers. The webhook resolves entitlement from the
# price ID on the subscription via these. Never hardcode dollar amounts.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_MAX_MONTHLY=""
STRIPE_PRICE_MAX_ANNUAL=""

# Vercel Cron shared secret. The cron route rejects requests without
# `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=""

# Optional SMS (Twilio). Max-tier SMS alerts activate only when all three are set.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
